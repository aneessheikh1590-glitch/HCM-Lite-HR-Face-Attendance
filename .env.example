# --- Server ---
PORT=3000
NODE_ENV=production
# Directory for the SQLite database file (mount a persistent disk/volume here in production)
DATA_DIR=./data
# Office timezone used for "today" and the late cutoff
OFFICE_TZ=Asia/Karachi
# Optional: fixed JWT signing key. If empty, a random key is generated once and stored in the database.
JWT_SECRET=
# Dev only: print password-reset codes to the server console (codes are always delivered to Admins in-app)
RESET_CODE_TO_CONSOLE=false

# --- AI assistant (Google Gemini via @google/genai, tool calling). Key stays on the backend only. ---
# Leave empty to run without AI: chat then answers with a clearly labelled rule-based DB fallback.
AI_API_KEY=

# --- Face recognition ---
# Euclidean distance limit between a live face and the enrolled template (lower = stricter). face-api default is 0.6.
# MUST be validated with your own employees/cameras before relying on it.
FACE_MATCH_THRESHOLD=0.5
# Key used to encrypt stored face templates (AES-256-GCM). If empty, a random key is generated once and stored in the database.
# Set it explicitly in production and keep it safe: losing it makes enrolled templates unreadable (employees must re-enroll).
FACE_ENCRYPTION_KEY=
